DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cre_leads
REDIS_URL=redis://localhost:6379
API_TOKEN=change-me-to-a-long-random-token
RESEND_API_KEY=
DIGEST_FROM=leads@example.com
DIGEST_RECIPIENTS=agent@example.com

# County clone: greenville (default) or spartanburg scaffold
COUNTY_SLUG=greenville
ARCGIS_PARCEL_LAYER_URL=https://www.gcgis.org/arcgis/rest/services/GreenvilleJS/Map_Layers_JS/MapServer/52
ARCGIS_MAX_CONCURRENCY=2
ARCGIS_PAGE_DELAY_MS=250
ARCGIS_USER_AGENT=GreenvilleCRE-LeadEngine/1.0 (+contact@example.com)
SCORE_VERSION=v3
COUNTY_NAME=Greenville
COUNTY_HOME_STATE=SC
COUNTY_PARCEL_LINK_BASE=https://www.greenvillecounty.org/appsas400/RealProperty/
DIGEST_TOP_N=10
DIGEST_EXCLUSION_DAYS=90
DIGEST_RESEND_SCORE_DELTA=15
DIGEST_FMV_FLOOR=250000
OUTREACH_AGENT_NAME=

# SoS entity resolution (OpenSosData or compatible). Official SC SoS site is captcha-gated.
SOS_API_KEY=
OPENSOSDATA_API_KEY=
SOS_API_BASE_URL=https://api.opensosdata.com/v1

# Greenville ROD (GovOS Cloud Search) — form login + WebSocket search.
# Sign up free: https://greenville.sc.publicsearch.us/ → Register
# Instructions: https://www.greenvillecounty.org/ROD/pdf/NewCloudSearchInstructions.pdf
# Cron 7:30/15:30 ET + Admin → ROD deed watch.
ROD_SCRAPER_ENABLED=false
ROD_EMAIL=
ROD_PASSWORD=
ROD_BASE_URL=https://greenville.sc.publicsearch.us
ROD_DEPARTMENT=RP
ROD_MAX_RESULTS=40
ROD_LOOKBACK_DAYS=3
ROD_MIN_DELAY_MS=750

# Industrial Signals (occupier space-change) — Admin → Signals
# UCC live path (pick one). Interactive SOS search is CAPTCHA-gated — do not scrape.
# Official bulk: SCI monthly CSV drop (~$12k/yr) → extract to UCC_BULK_DIR.
# Signup: https://scdgs.sc.gov/service/secretary-state-bulk-data-images-and-notary-registration
UCC_FEED_URL=
UCC_BULK_CSV_URL=
UCC_BULK_DIR=
# Optional JSON map of column aliases for SCI flat files
# UCC_BULK_COLUMN_MAP={"filingNumber":"FileNumber","filingDate":"FileDate"}
FMCSA_FEED_URL=
# EPA ECHO — live REST when unset; set ECHO_FEED_URL for JSON fixture feed.
# SIGNAL_ECHO_ENABLED=false disables live fetch. ECHO_FIPS defaults to Greenville CSA.
ECHO_FEED_URL=
ECHO_FIPS=
SIGNAL_ECHO_ENABLED=
# SBA FOIA — JSON feed and/or 504/7(a) CSV URLs (Admin paste also works).
SBA_FEED_URL=
SBA_504_CSV_URL=
SBA_7A_CSV_URL=
# Tier-2 imports (BOL) — opt-in; paste fixtures work without the flag.
SIGNAL_IMPORTS_ENABLED=false
IMPORTS_FEED_URL=
# Tier-2 hiring — opt-in; paste postings aggregate to surges (≥8 / address / 60d).
SIGNAL_HIRING_ENABLED=false
HIRING_FEED_URL=
# Aerial / yard — YardObservation Admin form, or AERIAL_FEED_URL JSON events.
AERIAL_FEED_URL=

# Skip-trace HTTP provider (top leads only; weekly cap).
SKIPTRACE_API_URL=
SKIPTRACE_API_KEY=
SKIPTRACE_WEEKLY_CAP=25

# Distress list scrapers (best-effort HTML). Admin → Tax delinquency sync.
# Also derives tax_delinquent from Parcel.paidDate null + totalTax.
DISTRESS_SCRAPER_ENABLED=true
TAX_SALE_URL=
FORECLOSURE_ROSTER_URL=https://mie.greenvillejournal.com/



# v3 catalyst feeds (optional; stub safely when unset)
PLANNING_SCRAPER_ENABLED=true
PLANNING_AGENDA_URL=
PERMITS_API_URL=
LISTINGS_API_URL=
LISTINGS_API_KEY=
PROBATE_SCRAPER_ENABLED=true
PROBATE_INDEX_URL=
# Flood: leave FLOOD_API_URL empty to use public FEMA NFHL. Set FLOOD_SCRAPER_ENABLED=false to disable.
FLOOD_API_URL=
FLOOD_API_KEY=
FLOOD_SCRAPER_ENABLED=true
# Assessor HTML scrape (best-effort). Greenville form UI often returns link-only.
ASSESSOR_SCRAPER_ENABLED=true

# CRM webhook (HubSpot / Follow Up Boss compatible JSON). Dry-run when unset.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
CRM_PROVIDER=webhook

# AI analytics + event intelligence (Anthropic)
# On Railway: set these on the API service (not a separate static site), then Redeploy.
# Accepts true/True/1/yes. If LLM_ENABLED is unset but ANTHROPIC_API_KEY is set → AI auto-on.
# Explicit LLM_ENABLED=false always disables.
LLM_ENABLED=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_OPENER_POLISH=false
# seed = Greenville CRE calendar placeholders (no API key). Add eventbrite/ics for live feeds.
# LinkedIn: no automation — paste event lines via Admin/Events UI only.
EVENT_SOURCES_ENABLED=manual,seed,eventbrite,ics
EVENTBRITE_TOKEN=
# Comma-separated sourceId|url pairs for association calendars (public ICS only)
# Example: chamber|https://example.com/calendar.ics,naiop|https://example.com/naiop.ics
EVENT_ICS_FEEDS=
POST_AND_COURIER_EVENTS_URL=
BISNOW_EVENTS_URL=
PROBATE_LEAD_DELAY_DAYS=60
REGISTERED_AGENT_BLOCKLIST=
OUTREACH_AGENT_PHONE=
OUTREACH_AGENT_EMAIL=

# Public company website contact scrape (homepage /contact /about only — no LinkedIn).
# Default on. Set false to disable probing inferred domains.
WEBSITE_SCRAPER_ENABLED=true

PORT=3000
TZ=America/New_York
