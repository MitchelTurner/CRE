generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parcel {
  id               String             @id @default(cuid())
  pin              String             @unique
  situsAddress     String?
  landUseCode      String?
  landUseDesc      String?
  propType         String?
  subdivision      String?
  deedDate         DateTime?
  fairMarketVal    Int?
  salePrice        Int?
  totalTax         Float?
  paidDate         DateTime?
  latitude         Float?
  longitude        Float?
  floodZone        String?
  submarket        String?
  countySlug       String             @default("greenville")
  rawAttributes    Json
  owner            Owner?             @relation(fields: [ownerId], references: [id])
  ownerId          String?
  scores           Score[]
  signals          Signal[]
  leads            Lead[]
  enrichmentReviews EnrichmentReview[]
  saleComps        SaleComp[]
  notes            Note[]
  fieldCaptures    FieldCapture[]
  firstSeenAt      DateTime           @default(now())

  lastSyncedAt     DateTime           @updatedAt
  isCommercial     Boolean            @default(false)
  isActive         Boolean            @default(true)

  @@index([landUseCode])
  @@index([isCommercial, isActive])
  @@index([ownerId])
  @@index([fairMarketVal])
  @@index([latitude, longitude])
  @@index([submarket])
  @@index([countySlug])
}

model Owner {
  id                   String             @id @default(cuid())
  nameRaw              String
  nameNormalized       String
  mailingAddress       String             @default("")
  mailingCity          String?
  mailingState         String?
  mailingZip           String?
  isEntity             Boolean            @default(false)
  isAbsentee           Boolean            @default(false)
  sosEntityId          String?
  sosStatus            String?
  sosRegisteredAgent   String?
  sosAgentAddress      String?
  sosFetchedAt         DateTime?
  sosRaw               Json?
  /// Best-effort public company website (inferred or scraped).
  websiteUrl           String?
  websiteFetchedAt     DateTime?
  clusterKey           String?
  portfolioScore       Int?
  relatedOwnerIds      Json?
  parcels              Parcel[]
  contacts             Contact[]
  personMatches        PersonOwnerMatch[]

  @@index([nameNormalized])
  @@index([clusterKey])
  @@unique([nameNormalized, mailingAddress])
}

model Contact {
  id        String   @id @default(cuid())
  owner     Owner    @relation(fields: [ownerId], references: [id])
  ownerId   String
  name      String?
  role      String?
  phone     String?
  email     String?
  source    String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Score {
  id           String   @id @default(cuid())
  parcel       Parcel   @relation(fields: [parcelId], references: [id])
  parcelId     String
  total        Int
  components   Json
  scoredAt     DateTime @default(now())
  scoreVersion String

  @@index([parcelId, scoredAt])
  @@index([total])
}

model Signal {
  id         String    @id @default(cuid())
  parcel     Parcel    @relation(fields: [parcelId], references: [id])
  parcelId   String
  type       String
  payload    Json
  detectedAt DateTime  @default(now())
  expiresAt  DateTime?

  @@index([parcelId, type])
  @@index([type, detectedAt])
}

model Lead {
  id           String         @id @default(cuid())
  parcel       Parcel         @relation(fields: [parcelId], references: [id])
  parcelId     String
  status       String         @default("new")
  leadType     String         @default("seller")
  digestId     String?
  whyNow       String
  lastOutcome  String?
  snoozedUntil DateTime?
  feedback     LeadFeedback[]
  crmSyncs     CrmSync[]
  notes        Note[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([parcelId])
  @@index([leadType])
  @@index([snoozedUntil])
}

model LeadFeedback {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String
  rating    String
  reason    String?
  note      String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([rating])
  @@index([reason])
}

model EnrichmentReview {
  id        String   @id @default(cuid())
  parcel    Parcel   @relation(fields: [parcelId], references: [id])
  parcelId  String
  status    String   @default("pending")
  reasons   Json
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([parcelId])
}

model CrmSync {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id])
  leadId     String
  provider   String
  externalId String?
  status     String
  payload    Json?
  error      String?
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([provider, status])
}

model Digest {
  id        String    @id @default(cuid())
  sentAt    DateTime?
  leadCount Int
  htmlBody  String
}

model SyncRun {
  id              String    @id @default(cuid())
  source          String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String
  recordsSeen     Int       @default(0)
  recordsUpserted Int       @default(0)
  error           String?
}

model AppConfig {
  key   String @id
  value Json
}

/// M4 — local CRE events the agent should attend (or host).
model Event {
  id           String          @id @default(cuid())
  name         String
  startsAt     DateTime
  endsAt       DateTime?
  venue        String?
  city         String?
  hostOrg      String?
  url          String?
  sourceId     String
  category     String?
  ownerDensity String?
  audience     String?
  rawPayload   Json
  dedupeKey    String          @unique
  status       String          @default("new")
  briefs       EventBrief[]
  attendees    EventAttendee[]
  notes        Note[]
  createdAt    DateTime        @default(now())

  @@index([startsAt])
  @@index([ownerDensity, status])
  @@index([status])
}

/// M5 — people from directories, sponsor lists, or paste-in.
model Person {
  id             String             @id @default(cuid())
  nameRaw        String
  nameNormalized String
  company        String?
  title          String?
  source         String
  linkedinUrl    String?
  ownerMatches   PersonOwnerMatch[]
  eventLinks     EventAttendee[]
  notes          Note[]
  createdAt      DateTime           @default(now())

  @@index([nameNormalized])
  @@index([source])
}

model EventAttendee {
  id       String    @id @default(cuid())
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  role     String
  /// Agent marked "met / seen at event" — closes brief → relationship loop.
  metAt    DateTime?

  @@unique([eventId, personId])
  @@index([eventId])
  @@index([personId])
  @@index([metAt])
}

/// ROD deed / sale comps for market report + parcel insight.
model SaleComp {
  id         String    @id @default(cuid())
  parcel     Parcel?   @relation(fields: [parcelId], references: [id])
  parcelId   String?
  pin        String?
  recordedAt DateTime
  grantor    String?
  grantee    String?
  salePrice  Int?
  buyerType  String?
  book       String?
  page       String?
  raw        Json?
  createdAt  DateTime  @default(now())

  @@index([parcelId, recordedAt])
  @@index([pin])
  @@index([recordedAt])
}

model PersonOwnerMatch {
  id         String   @id @default(cuid())
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId   String
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  confidence Float
  method     String
  confirmed  Boolean?
  createdAt  DateTime @default(now())

  @@unique([personId, ownerId])
  @@index([ownerId])
  @@index([confirmed])
}

model EventBrief {
  id         String   @id @default(cuid())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  htmlBody   String
  matchCount Int
  createdAt  DateTime @default(now())

  @@index([eventId, createdAt])
}

/// M7 — quarterly market report snapshot.
model Report {
  id          String   @id @default(cuid())
  kind        String   @default("quarterly")
  periodStart DateTime
  periodEnd   DateTime
  stats       Json
  htmlBody    String
  createdAt   DateTime @default(now())

  @@index([kind, periodEnd])
}

/// Single-tenant progress / gamification (userKey = "default").
model UserProgress {
  id           String    @id @default(cuid())
  userKey      String    @unique @default("default")
  xp           Int       @default(0)
  level        Int       @default(1)
  streakDays   Int       @default(0)
  lastActiveOn DateTime?
  updatedAt    DateTime  @updatedAt
}

model XpEvent {
  id         String   @id @default(cuid())
  userKey    String   @default("default")
  action     String
  xpDelta    Int
  entityType String?
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userKey, createdAt])
  @@unique([userKey, action, entityId])
}

model UserBadge {
  id       String   @id @default(cuid())
  userKey  String   @default("default")
  badgeId  String
  earnedAt DateTime @default(now())

  @@unique([userKey, badgeId])
  @@index([userKey, earnedAt])
}

/// Freeform notes: property / connection / meeting.
model Note {
  id        String    @id @default(cuid())
  kind      String
  title     String?
  body      String
  parcelId  String?
  personId  String?
  leadId    String?
  eventId   String?
  meetingAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parcel Parcel? @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: Cascade)
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([parcelId])
  @@index([personId])
  @@index([leadId])
  @@index([eventId])
}

/// Drive-by / field capture (GPS + optional photo + note).
model FieldCapture {
  id          String   @id @default(cuid())
  parcelId    String?
  latitude    Float
  longitude   Float
  note        String?
  /// vacancy | for_lease | deferred_maint | other
  tags        String[] @default([])
  imageMime   String?
  /// Small JPEG/WebP base64 (no data: prefix). Keep under ~800KB.
  imageBase64 String?
  distanceM   Float?
  createdAt   DateTime @default(now())

  parcel Parcel? @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@index([parcelId, createdAt])
  @@index([createdAt])
  @@index([latitude, longitude])
}

// ─── Industrial Signals (occupier space-change intelligence) ───────────────
// Named IndustrialSignal to avoid colliding with parcel enrichment `Signal`.
// Site.parcelId maps to the existing Parcel model (no separate Property table).

enum IndustrialSignalType {
  EQUIPMENT_FINANCING
  FLEET_CHANGE
  NEW_CARRIER
  ENV_PERMIT
  GENERATOR_STATUS_CHANGE
  SBA_LOAN
  IMPORT_VOLUME
  HIRING_SURGE
  YARD_UTILIZATION
  UTILITY_CAPACITY
  REFERRAL
}

model Company {
  id             String            @id @default(cuid())
  canonicalName  String
  normalizedName String            @unique
  naics          String?
  dotNumber      String?           @unique
  scSosEntityId  String?           @unique
  employeeCount  Int?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  aliases        CompanyAlias[]
  sites          Site[]
  signals        IndustrialSignal[]
  spaceScore     SpaceScore?

  @@index([normalizedName])
}

model CompanyAlias {
  id             String  @id @default(cuid())
  companyId      String
  alias          String
  normalizedName String
  source         String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([normalizedName])
  @@index([companyId])
}

model Site {
  id           String    @id @default(cuid())
  companyId    String
  parcelId     String?
  rawAddress   String
  normalized   String
  latitude     Float?
  longitude    Float?
  matchMethod  String?
  matchConf    Float?
  isPrimary    Boolean   @default(false)
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  signals IndustrialSignal[]

  @@index([parcelId])
  @@index([normalized])
  @@index([companyId])
}

/// Occupier/owner event (orthogonal to parcel enrichment Signal).
model IndustrialSignal {
  id          String               @id @default(cuid())
  type        IndustrialSignalType
  subtype     String?
  companyId   String
  siteId      String?
  parcelId    String?
  occurredAt  DateTime
  observedAt  DateTime             @default(now())
  source      String
  sourceRef   String
  weight      Float
  confidence  Float                @default(1.0)
  headline    String
  payload     Json
  dismissedAt DateTime?
  dismissedBy String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([source, sourceRef])
  @@index([companyId, occurredAt])
  @@index([parcelId, occurredAt])
  @@index([type, occurredAt])
}

model SpaceScore {
  companyId     String   @id
  score         Float
  bandLabel     String
  topSignalIds  String[]
  computedAt    DateTime
  previousScore Float?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Landing table for connector raw payloads (reprocess without re-fetch).
model SignalRaw {
  id         String   @id @default(cuid())
  source     String
  sourceRef  String
  bodyHash   String
  body       Json
  fetchedAt  DateTime @default(now())
  processedAt DateTime?

  @@unique([source, sourceRef, bodyHash])
  @@index([source, fetchedAt])
  @@index([processedAt])
}

model FmcsaSnapshot {
  id            String   @id @default(cuid())
  dotNumber     String
  snapshotMonth String
  legalName     String
  phyStreet     String?
  phyCity       String?
  phyState      String?
  phyZip        String?
  powerUnits    Int      @default(0)
  drivers       Int      @default(0)
  cargoCarried  String?
  mcs150Mileage Int?
  raw           Json?
  createdAt     DateTime @default(now())

  @@unique([dotNumber, snapshotMonth])
  @@index([phyState, phyZip])
  @@index([snapshotMonth])
}

model ResolutionReview {
  id             String   @id @default(cuid())
  kind           String
  status         String   @default("pending")
  rawName        String?
  rawAddress     String?
  normalizedName String?
  candidateId    String?
  candidateScore Float?
  payload        Json?
  note           String?
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?

  @@index([status, createdAt])
  @@index([kind, status])
}

model SignalPlaybook {
  id          String               @id @default(cuid())
  type        IndustrialSignalType
  subtype     String               @default("")
  channel     String
  urgencyDays Int
  talkTrack   String

  @@unique([type, subtype])
}

model BuildingAttributes {
  parcelId         String    @id
  clearHeightFt    Float?
  dockDoors        Int?
  driveInDoors     Int?
  sprinklerType    String?
  powerAmps        Int?
  powerVolts       Int?
  railServed       Boolean?
  yardAcres        Float?
  trailerStalls    Int?
  officeSf         Int?
  craneCapacityTon Float?
  yearBuilt        Int?
  verifiedAt       DateTime?
  verifiedBy       String?
  sourceNotes      String?
}

model Requirement {
  id             String   @id @default(cuid())
  clientName     String
  minSf          Int?
  maxSf          Int?
  minClearHeight Float?
  minDockDoors   Int?
  minYardAcres   Float?
  railRequired   Boolean  @default(false)
  submarkets     String[] @default([])
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model YardObservation {
  id               String   @id @default(cuid())
  siteId           String?
  parcelId         String?
  flightDate       DateTime
  trailerCount     Int?
  containerCount   Int?
  yardCoveragePct  Float?
  imageRef         String?
  annotatedImageRef String?
  createdAt        DateTime @default(now())

  @@index([siteId, flightDate])
  @@index([parcelId, flightDate])
}

