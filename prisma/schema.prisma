generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parcel {
  id               String             @id @default(cuid())
  pin              String             @unique
  situsAddress     String?
  landUseCode      String?
  landUseDesc      String?
  propType         String?
  subdivision      String?
  deedDate         DateTime?
  fairMarketVal    Int?
  salePrice        Int?
  totalTax         Float?
  paidDate         DateTime?
  latitude         Float?
  longitude        Float?
  floodZone        String?
  submarket        String?
  countySlug       String             @default("greenville")
  rawAttributes    Json
  owner            Owner?             @relation(fields: [ownerId], references: [id])
  ownerId          String?
  scores           Score[]
  signals          Signal[]
  leads            Lead[]
  enrichmentReviews EnrichmentReview[]
  saleComps        SaleComp[]
  firstSeenAt      DateTime           @default(now())
  lastSyncedAt     DateTime           @updatedAt
  isCommercial     Boolean            @default(false)
  isActive         Boolean            @default(true)

  @@index([landUseCode])
  @@index([isCommercial, isActive])
  @@index([ownerId])
  @@index([fairMarketVal])
  @@index([latitude, longitude])
  @@index([submarket])
  @@index([countySlug])
}

model Owner {
  id                   String             @id @default(cuid())
  nameRaw              String
  nameNormalized       String
  mailingAddress       String             @default("")
  mailingCity          String?
  mailingState         String?
  mailingZip           String?
  isEntity             Boolean            @default(false)
  isAbsentee           Boolean            @default(false)
  sosEntityId          String?
  sosStatus            String?
  sosRegisteredAgent   String?
  sosAgentAddress      String?
  sosFetchedAt         DateTime?
  sosRaw               Json?
  /// Best-effort public company website (inferred or scraped).
  websiteUrl           String?
  websiteFetchedAt     DateTime?
  clusterKey           String?
  portfolioScore       Int?
  relatedOwnerIds      Json?
  parcels              Parcel[]
  contacts             Contact[]
  personMatches        PersonOwnerMatch[]

  @@index([nameNormalized])
  @@index([clusterKey])
  @@unique([nameNormalized, mailingAddress])
}

model Contact {
  id        String   @id @default(cuid())
  owner     Owner    @relation(fields: [ownerId], references: [id])
  ownerId   String
  name      String?
  role      String?
  phone     String?
  email     String?
  source    String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Score {
  id           String   @id @default(cuid())
  parcel       Parcel   @relation(fields: [parcelId], references: [id])
  parcelId     String
  total        Int
  components   Json
  scoredAt     DateTime @default(now())
  scoreVersion String

  @@index([parcelId, scoredAt])
  @@index([total])
}

model Signal {
  id         String    @id @default(cuid())
  parcel     Parcel    @relation(fields: [parcelId], references: [id])
  parcelId   String
  type       String
  payload    Json
  detectedAt DateTime  @default(now())
  expiresAt  DateTime?

  @@index([parcelId, type])
  @@index([type, detectedAt])
}

model Lead {
  id           String         @id @default(cuid())
  parcel       Parcel         @relation(fields: [parcelId], references: [id])
  parcelId     String
  status       String         @default("new")
  leadType     String         @default("seller")
  digestId     String?
  whyNow       String
  lastOutcome  String?
  snoozedUntil DateTime?
  feedback     LeadFeedback[]
  crmSyncs     CrmSync[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([parcelId])
  @@index([leadType])
  @@index([snoozedUntil])
}

model LeadFeedback {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String
  rating    String
  reason    String?
  note      String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([rating])
  @@index([reason])
}

model EnrichmentReview {
  id        String   @id @default(cuid())
  parcel    Parcel   @relation(fields: [parcelId], references: [id])
  parcelId  String
  status    String   @default("pending")
  reasons   Json
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([parcelId])
}

model CrmSync {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id])
  leadId     String
  provider   String
  externalId String?
  status     String
  payload    Json?
  error      String?
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([provider, status])
}

model Digest {
  id        String    @id @default(cuid())
  sentAt    DateTime?
  leadCount Int
  htmlBody  String
}

model SyncRun {
  id              String    @id @default(cuid())
  source          String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String
  recordsSeen     Int       @default(0)
  recordsUpserted Int       @default(0)
  error           String?
}

model AppConfig {
  key   String @id
  value Json
}

/// M4 — local CRE events the agent should attend (or host).
model Event {
  id           String          @id @default(cuid())
  name         String
  startsAt     DateTime
  endsAt       DateTime?
  venue        String?
  city         String?
  hostOrg      String?
  url          String?
  sourceId     String
  category     String?
  ownerDensity String?
  audience     String?
  rawPayload   Json
  dedupeKey    String          @unique
  status       String          @default("new")
  briefs       EventBrief[]
  attendees    EventAttendee[]
  createdAt    DateTime        @default(now())

  @@index([startsAt])
  @@index([ownerDensity, status])
  @@index([status])
}

/// M5 — people from directories, sponsor lists, or paste-in.
model Person {
  id             String             @id @default(cuid())
  nameRaw        String
  nameNormalized String
  company        String?
  title          String?
  source         String
  linkedinUrl    String?
  ownerMatches   PersonOwnerMatch[]
  eventLinks     EventAttendee[]
  createdAt      DateTime           @default(now())

  @@index([nameNormalized])
  @@index([source])
}

model EventAttendee {
  id       String    @id @default(cuid())
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  role     String
  /// Agent marked "met / seen at event" — closes brief → relationship loop.
  metAt    DateTime?

  @@unique([eventId, personId])
  @@index([eventId])
  @@index([personId])
  @@index([metAt])
}

/// ROD deed / sale comps for market report + parcel insight.
model SaleComp {
  id         String    @id @default(cuid())
  parcel     Parcel?   @relation(fields: [parcelId], references: [id])
  parcelId   String?
  pin        String?
  recordedAt DateTime
  grantor    String?
  grantee    String?
  salePrice  Int?
  buyerType  String?
  book       String?
  page       String?
  raw        Json?
  createdAt  DateTime  @default(now())

  @@index([parcelId, recordedAt])
  @@index([pin])
  @@index([recordedAt])
}

model PersonOwnerMatch {
  id         String   @id @default(cuid())
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId   String
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  confidence Float
  method     String
  confirmed  Boolean?
  createdAt  DateTime @default(now())

  @@unique([personId, ownerId])
  @@index([ownerId])
  @@index([confirmed])
}

model EventBrief {
  id         String   @id @default(cuid())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  htmlBody   String
  matchCount Int
  createdAt  DateTime @default(now())

  @@index([eventId, createdAt])
}

/// M7 — quarterly market report snapshot.
model Report {
  id          String   @id @default(cuid())
  kind        String   @default("quarterly")
  periodStart DateTime
  periodEnd   DateTime
  stats       Json
  htmlBody    String
  createdAt   DateTime @default(now())

  @@index([kind, periodEnd])
}
