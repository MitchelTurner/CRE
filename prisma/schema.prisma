generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parcel {
  id               String             @id @default(cuid())
  pin              String             @unique
  situsAddress     String?
  landUseCode      String?
  landUseDesc      String?
  propType         String?
  subdivision      String?
  deedDate         DateTime?
  fairMarketVal    Int?
  salePrice        Int?
  totalTax         Float?
  paidDate         DateTime?
  latitude         Float?
  longitude        Float?
  floodZone        String?
  rawAttributes    Json
  owner            Owner?             @relation(fields: [ownerId], references: [id])
  ownerId          String?
  scores           Score[]
  signals          Signal[]
  leads            Lead[]
  enrichmentReviews EnrichmentReview[]
  firstSeenAt      DateTime           @default(now())
  lastSyncedAt     DateTime           @updatedAt
  isCommercial     Boolean            @default(false)
  isActive         Boolean            @default(true)

  @@index([landUseCode])
  @@index([isCommercial, isActive])
  @@index([ownerId])
  @@index([fairMarketVal])
  @@index([latitude, longitude])
}

model Owner {
  id                   String    @id @default(cuid())
  nameRaw              String
  nameNormalized       String
  mailingAddress       String    @default("")
  mailingCity          String?
  mailingState         String?
  mailingZip           String?
  isEntity             Boolean   @default(false)
  isAbsentee           Boolean   @default(false)
  sosEntityId          String?
  sosStatus            String?
  sosRegisteredAgent   String?
  sosAgentAddress      String?
  sosFetchedAt         DateTime?
  sosRaw               Json?
  clusterKey           String?
  portfolioScore       Int?
  relatedOwnerIds      Json?
  parcels              Parcel[]
  contacts             Contact[]

  @@index([nameNormalized])
  @@index([clusterKey])
  @@unique([nameNormalized, mailingAddress])
}

model Contact {
  id        String   @id @default(cuid())
  owner     Owner    @relation(fields: [ownerId], references: [id])
  ownerId   String
  name      String?
  role      String?
  phone     String?
  email     String?
  source    String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Score {
  id           String   @id @default(cuid())
  parcel       Parcel   @relation(fields: [parcelId], references: [id])
  parcelId     String
  total        Int
  components   Json
  scoredAt     DateTime @default(now())
  scoreVersion String

  @@index([parcelId, scoredAt])
  @@index([total])
}

model Signal {
  id         String    @id @default(cuid())
  parcel     Parcel    @relation(fields: [parcelId], references: [id])
  parcelId   String
  type       String
  payload    Json
  detectedAt DateTime  @default(now())
  expiresAt  DateTime?

  @@index([parcelId, type])
  @@index([type, detectedAt])
}

model Lead {
  id           String         @id @default(cuid())
  parcel       Parcel         @relation(fields: [parcelId], references: [id])
  parcelId     String
  status       String         @default("new")
  leadType     String         @default("seller")
  digestId     String?
  whyNow       String
  lastOutcome  String?
  snoozedUntil DateTime?
  feedback     LeadFeedback[]
  crmSyncs     CrmSync[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([parcelId])
  @@index([leadType])
  @@index([snoozedUntil])
}

model LeadFeedback {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String
  rating    String
  reason    String?
  note      String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([rating])
  @@index([reason])
}

model EnrichmentReview {
  id        String   @id @default(cuid())
  parcel    Parcel   @relation(fields: [parcelId], references: [id])
  parcelId  String
  status    String   @default("pending")
  reasons   Json
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([parcelId])
}

model CrmSync {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id])
  leadId     String
  provider   String
  externalId String?
  status     String
  payload    Json?
  error      String?
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([provider, status])
}

model Digest {
  id        String    @id @default(cuid())
  sentAt    DateTime?
  leadCount Int
  htmlBody  String
}

model SyncRun {
  id              String    @id @default(cuid())
  source          String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String
  recordsSeen     Int       @default(0)
  recordsUpserted Int       @default(0)
  error           String?
}

model AppConfig {
  key   String @id
  value Json
}
